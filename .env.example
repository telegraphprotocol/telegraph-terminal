# Browser → engine WebSocket (still direct to engine; not proxied by Next).
# Use ws://localhost:7044/ws when the browser can reach engine on the same host.
# For remote-only access via a tunnel, expose engine WS on a public URL (or put Nginx in front).
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:7044/ws

NEXT_PUBLIC_RESOURCE_SERVER_URL=https://your-telegraph-node.com
NEXT_PUBLIC_DEFAULT_NETWORK=base  # or solana
NEXT_PUBLIC_MIN_PRICE_USDC=0.01

# --- Telegraph dispatcher ----------------------------------------------------
NEXT_PUBLIC_TELEGRAPH_BASE_URL=http://54.252.48.30:7044

# --- Subnet chat path (x402 POST: TELEGRAPH_BASE_URL + path) -----------------
NEXT_PUBLIC_SUBNET_GROQ_CHAT_PATH=/subnet-dispatcher/v1/102/chat

# --- Solana (x402 settlement explorer links only) ----------------------------
NEXT_PUBLIC_SOLANA_EXPLORER_TX_URL=https://explorer.solana.com/tx
# Append to explorer URL after tx id, e.g. https://explorer.solana.com/tx/<sig>?cluster=devnet
NEXT_PUBLIC_SOLANA_EXPLORER_CLUSTER_QUERY=?cluster=devnet

# --- Polygon (explorer links for eip155:137 settlements) --------------------
NEXT_PUBLIC_POLYGON_EXPLORER_TX_URL=https://polygonscan.com/tx

# --- Terminal Backend (custodial x402 + wallet UI) ---------------------------
# When true, Intelligence Terminal uses Terminal Backend via Next `/api/core/*` proxy (no wagmi).
NEXT_PUBLIC_USE_TERMINAL_BACKEND_X402=true

# Next server → Terminal Backend (never expose TERMINAL_BACKEND_API_KEY to the browser)
TERMINAL_BACKEND_INTERNAL_URL=http://localhost:3030
TERMINAL_BACKEND_API_KEY=dev-local-key

# Next server → Engine / Daemon (HTTP only; browser uses same-origin `/api/engine/*`, `/api/daemon/*`)
ENGINE_INTERNAL_URL=http://localhost:7044
DAEMON_INTERNAL_URL=http://localhost:8081

# --- Legacy browser x402 (removed) -------------------------------------------
# NEXT_PUBLIC_USE_X402_CHAT and wagmi paths are replaced by Terminal Backend + NEXT_PUBLIC_USE_TERMINAL_BACKEND_X402.
NEXT_PUBLIC_X402_PREFERRED_EVM_CHAIN_ID=84532
NEXT_PUBLIC_X402_CHAT_MODEL=gpt-4o-mini
