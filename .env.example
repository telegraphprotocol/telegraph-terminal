NEXT_PUBLIC_RESOURCE_SERVER_URL=http://54.252.48.30:7044
NEXT_PUBLIC_FACILITATOR_URL=https://facilitator.payai.network
NEXT_PUBLIC_DEFAULT_NETWORK=base  # or solana
NEXT_PUBLIC_MIN_PRICE_USDC=0.01

# --- Telegraph dispatcher ----------------------------------------------------
NEXT_PUBLIC_TELEGRAPH_BASE_URL=http://54.252.48.30:7044

# --- Subnet paths (POST to: TELEGRAPH_BASE_URL + path) -----------------------
NEXT_PUBLIC_SUBNET_ITSAI_PATH=/subnet-dispatcher/v1/32/detect
NEXT_PUBLIC_SUBNET_BITMIND_PATH=/subnet-dispatcher/v1/34/detect-image
NEXT_PUBLIC_SUBNET_GROQ_CHAT_PATH=/subnet-dispatcher/v1/102/chat
NEXT_PUBLIC_SUBNET_DESEARCH_MINI_PATH=/subnet-dispatcher/v1/101/search/mini

# --- Solana (wallet UI + explorer links) ------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_SOLANA_EXPLORER_TX_URL=https://explorer.solana.com/tx
# Append to explorer URL after tx id, e.g. https://explorer.solana.com/tx/<sig>?cluster=devnet
NEXT_PUBLIC_SOLANA_EXPLORER_CLUSTER_QUERY=?cluster=devnet

# --- EVM / Polygon (Telegraph x402 rail in Polymarket-style setup) ------------
NEXT_PUBLIC_POLYGON_CHAIN_ID=137
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_POLYGON_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
NEXT_PUBLIC_POLYGON_EXPLORER_TX_URL=https://polygonscan.com/tx

# --- Your Next app (local dev; change for deployed URL) ----------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: same-origin proof API (example: Next Route Handler under /api/proof)
# Use empty string if unused. Example local value:
NEXT_PUBLIC_PAYMENT_PROOF_API_URL=http://localhost:3000/api

# --- Browser x402 chat (direct POST to Telegraph subnet-dispatcher) ------------
# When true, intelligence terminal sends each message via HTTP+x402 instead of engine WS.
NEXT_PUBLIC_USE_X402_CHAT=false
# Chain id to switch to before paying (must match an entry in the 402 `accepts` list).
NEXT_PUBLIC_X402_PREFERRED_EVM_CHAIN_ID=84532
# OpenAI-style `model` field for subnet 102 /chat.
NEXT_PUBLIC_X402_CHAT_MODEL=gpt-4o-mini
# Wallet must be able to switch to Base Sepolia (84532) or Polygon (137) per dispatcher `accepts`.